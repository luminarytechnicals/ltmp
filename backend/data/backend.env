# ============================================================
#  LTMP Backend Configuration
#  Fill in your values here for LOCAL use.
#  On Render — set these in the dashboard under Environment Variables.
# ============================================================

# Get from https://my.telegram.org → API Development Tools
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE

# Login method: "phone" or "qr"
LOGIN_METHOD=phone

# Your phone number (only needed for phone login, e.g. +919876543210)
PHONE=

# Session file name (no spaces, no extension)
SESSION_NAME=my_account

# Local port (only used when running locally)
PORT=3421

# Safety limits — do not raise above defaults
ACTIONS_PER_MINUTE=8
FLOOD_WAIT_BUFFER=5

# ── Render only ──────────────────────────────────────────────
# STORAGE_DIR is set automatically by render.yaml to /var/data
# Do not set it here unless you know what you're doing.
